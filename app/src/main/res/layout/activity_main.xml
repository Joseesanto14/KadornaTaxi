<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="275dp"
        android:layout_height="match_parent"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ic_kadorna"
            android:layout_width="163dp"
            android:layout_height="135dp"
            android:layout_marginTop="37dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_kadorna" />

        <TextView
            android:id="@+id/txttitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:text="Kadorna Taxi" />

        <View
            android:id="@+id/linha"
            android:layout_width="241dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center"
            android:background="@color/black" />

        <Button
            android:id="@+id/btSolicitarTaxi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"
            android:backgroundTint="@color/MOSTARDA"
            android:onClick="irSolicitacaoAcitivity"
            android:padding="12dp"
            android:text="Solicitação de Taxi"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:icon="@drawable/ic_solicitacao_taxi"
            app:iconGravity="end"
            app:iconTint="@color/black" />

        <Button
            android:id="@+id/btViagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="34dp"
            android:backgroundTint="@color/MOSTARDA"
            android:onClick="irViagensAcitivity"
            android:padding="12dp"
            android:text="Viagens"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:icon="@drawable/ic_viagens"
            app:iconGravity="end"
            app:iconTint="@color/black" />

        <Button
            android:id="@+id/btGerarRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="34dp"
            android:backgroundTint="@color/MOSTARDA"
            android:onClick="irGerarRelatorioAcitivity"
            android:padding="12dp"
            android:text="Gerar Relatório"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:icon="@drawable/ic_gerar_relatorio"
            app:iconGravity="end"
            app:iconTint="@color/black" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>