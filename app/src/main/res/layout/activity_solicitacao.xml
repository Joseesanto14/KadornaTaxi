<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SolicitacaoActivity">

    <ImageView
        android:id="@+id/ic_kadorna"
        android:layout_width="163dp"
        android:layout_height="135dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="37dp"
        android:background="@drawable/ic_kadorna"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txttitulo"
        android:layout_width="235dp"
        android:layout_height="30dp"
        android:layout_alignParentTop="false"
        android:layout_centerHorizontal="false"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Solicitação de Taxi"
        android:textAppearance="@style/titulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_kadorna" />

    <View
        android:id="@+id/linha"
        android:layout_width="241dp"
        android:layout_height="2dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txttitulo" />

    <TextView
        android:id="@+id/origem"
        android:layout_width="366dp"
        android:layout_height="27dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:text="Origem"
        android:textAppearance="@style/sobre_campo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linha" />

    <EditText
        android:id="@+id/edOrigem"
        android:layout_width="366dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="1dp"
        android:padding="10dp"
        android:background="@drawable/campo"
        android:ems="10"
        android:hint="Ex: Bofete"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/origem" />

    <LinearLayout
        android:id="@+id/linearDataHora"
        android:layout_width="366dp"
        android:layout_height="69dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edOrigem">

        <LinearLayout
            android:layout_width="183dp"
            android:layout_height="69dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/data"
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="Data"
                android:textAppearance="@style/sobre_campo" />

            <EditText
                android:id="@+id/edDataUm"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/campo"
                android:ems="10"
                android:hint="Ex: Bofete"
                android:inputType="date"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/origem" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="183dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hora"
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="Hora"
                android:textAppearance="@style/sobre_campo" />

            <EditText
                android:id="@+id/edHoraUm"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/campo"
                android:ems="10"
                android:hint="Ex: 12:30"
                android:inputType="time"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/origem" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/destino"
        android:layout_width="366dp"
        android:layout_height="27dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:text="Destino"
        android:textAppearance="@style/sobre_campo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearDataHora" />

    <EditText
        android:id="@+id/edDestino"
        android:layout_width="366dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="1dp"
        android:padding="10dp"
        android:background="@drawable/campo"
        android:ems="10"
        android:hint="Ex: Botucatu"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/destino" />

</androidx.constraintlayout.widget.ConstraintLayout>