<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.SolicitacaoActivity">

    <ImageView
        android:id="@+id/ic_kadorna"
        android:layout_width="163dp"
        android:layout_height="135dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/ic_kadorna"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edDestino"
        android:layout_width="366dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/campo"
        android:ems="10"
        android:hint="Ex: Botucatu"
        android:inputType="text"
        android:padding="10dp"
        android:text="Botucatu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/destino" />

    <EditText
        android:id="@+id/edJustificativa"
        android:layout_width="370dp"
        android:layout_height="43dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:hint="Ex: Levar funcionário"
        android:inputType="text"
        android:text="Levar funcionário"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="367dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="19dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edDestino">

        <LinearLayout
            android:layout_width="181dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data" />

            <EditText
                android:id="@+id/edDataDestino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="05/01/2026"
                android:inputType="text"
                android:text="05/01/2026" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora" />

            <EditText
                android:id="@+id/edHoraDestino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Ex: 12:50"
                android:inputType="text"
                android:text="12:50" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Justificativa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <TextView
        android:id="@+id/destino"
        android:layout_width="366dp"
        android:layout_height="27dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:text="Destino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearDataHora" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:onClick="voltarMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_media_rew" />

    <View
        android:id="@+id/linha"
        android:layout_width="241dp"
        android:layout_height="2dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txttitulo" />

    <LinearLayout
        android:id="@+id/linearDataHora"
        android:layout_width="366dp"
        android:layout_height="69dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edOrigem">

        <LinearLayout
            android:layout_width="183dp"
            android:layout_height="69dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/data"
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="Data" />

            <EditText
                android:id="@+id/edDataOrigem"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/campo"
                android:ems="10"
                android:hint="05/01/2026"
                android:inputType="date"
                android:text="05/01/2026"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent">

            </EditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="183dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hora"
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="Hora" />

            <EditText
                android:id="@+id/edHoraOrigem"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/campo"
                android:ems="10"
                android:hint="Ex: 12:30"
                android:inputType="time"
                android:text="12:30"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/origem" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/origem"
        android:layout_width="366dp"
        android:layout_height="27dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:text="Origem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linha" />

    <EditText
        android:id="@+id/edOrigem"
        android:layout_width="366dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/campo"
        android:ems="10"
        android:hint="Ex: Bofete"
        android:inputType="text"
        android:padding="10dp"
        android:text="Bofete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/origem" />

    <TextView
        android:id="@+id/txttitulo"
        android:layout_width="235dp"
        android:layout_height="30dp"
        android:layout_alignParentTop="false"
        android:layout_centerHorizontal="false"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Solicitação de Taxi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_kadorna" />

    <Button
        android:id="@+id/btGerarViagem"
        android:layout_width="193dp"
        android:layout_height="52dp"
        android:layout_marginStart="192dp"
        android:layout_marginBottom="16dp"
        android:onClick="salvarViagemDb"
        android:text="Gerar Viagem"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <CheckBox
        android:id="@+id/checkViagemSeparada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:text="Viagem Separada"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>